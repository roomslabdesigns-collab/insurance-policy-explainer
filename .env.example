# Copy this file to `.env` and edit as needed. `.env` is gitignored -- your
# local settings never get committed. Every line here is optional; the
# defaults (shown as comments) already work out of the box after setup.

# --- Local LLM server (llama_cpp.server) ---
# LLM_SERVER_URL=http://127.0.0.1:8000
# LLM_MODEL_NAME=qwen2.5-1.5b-instruct
# LLM_MODEL_PATH=C:\path\to\models\qwen2.5-1.5b-instruct-q4_k_m.gguf
# LLM_CONTEXT_SIZE=2048
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_TOKENS=300
# LLM_TEMPERATURE=0.1

# --- Evidence context sent to the LLM (token-efficiency controls) ---
# DEFAULT_CONTEXT_CHUNKS=3
# MAX_EVIDENCE_CHARS_PER_CHUNK=500

# --- Evidence sufficiency gate -- see app/config.py for how this value
#     was chosen (informed by Phase 5's retrieval evaluation) ---
# MIN_EVIDENCE_SCORE=0.30
